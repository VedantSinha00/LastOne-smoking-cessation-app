# Supabase Configuration
#
# Copy this file to `.env` and fill in the real values from the Supabase
# dashboard (Project Settings -> API). `.env` is gitignored.
#
# These are EXPO_PUBLIC_* vars: they are INLINED AT BUILD TIME into the JS
# bundle. The anon/publishable key is public by design (Row Level Security
# protects the data) -- it is safe to ship in the client.
#
# IMPORTANT for cloud (EAS) builds: a local `.env` is NOT uploaded to EAS.
# Cloud builds read these from the EAS environment instead. Register them with:
#   eas env:create --name EXPO_PUBLIC_SUPABASE_URL --value "<url>" \
#     --environment preview --environment production --visibility plaintext
#   eas env:create --name EXPO_PUBLIC_SUPABASE_ANON_KEY --value "<key>" \
#     --environment preview --environment production --visibility plaintext
# Verify before building:  eas env:list --environment preview
# If these are missing at build time, lib/supabase.ts falls back to a
# placeholder URL and the shipped app cannot reach the backend (auth shows
# "address not found"). See docs/REBUILD_CHECKLIST.md.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
